# ==============================================================================
# AUTOHEAL Environment Configuration Template (.env.example)
# ==============================================================================
# NOTICE FOR DEVELOPERS:
# 1. Do NOT insert actual API keys or secret credentials into this file.
# 2. To configure your local environment, copy this file to '.env':
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
# 3. Add your real secrets ONLY in the local '.env' file, which is ignored by Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini API Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio (https://aistudio.google.com/).
# Required for Diagnoser and Planner agent reasoning.
GEMINI_API_KEY=

# Model selection for Diagnoser and Planner agents
GEMINI_MODEL=gemini-2.5-flash

# Maximum allowed LLM API calls per day to avoid accidental quota exhaustion
MAX_LLM_CALLS_PER_DAY=50

# ------------------------------------------------------------------------------
# Execution Safety & Operating Mode
# ------------------------------------------------------------------------------
# DRY_RUN: When set to 'true', the Recovery Executor will simulate recovery
# actions (logging what would be done) without applying destructive Docker commands.
# Default must always remain 'true' during development and testing.
DRY_RUN=true

# ENVIRONMENT: 'development' or 'production'
ENVIRONMENT=development

# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Docker Connection Configuration
# ------------------------------------------------------------------------------
# Local Docker daemon socket/pipe URL:
# Windows Docker Desktop default named pipe: npipe:////./pipe/docker_engine
# Linux/WSL2 default socket: unix:///var/run/docker.sock
DOCKER_HOST=npipe:////./pipe/docker_engine

# Monitored Docker container label or container name filter
MONITORED_CONTAINER_LABEL=autoheal.monitored=true

# ------------------------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------------------------
# SQLite local file path
DATABASE_PATH=data/autoheal.db

# ------------------------------------------------------------------------------
# Streamlit Dashboard Configuration
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
